# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/vscrm?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Microsoft Entra ID (Azure AD) app registration - see README section 2 for setup steps
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Protects /api/cron/check-tasks and /api/cron/sync-outlook - generate any random string
CRON_SECRET=""

# DEV ONLY: set to "true" to add a no-password "Continue as this user" login
# option, so you can run and click through the app without an Azure AD app
# registration. Outlook features won't work for accounts created this way.
# NEVER set this to "true" in a real deployment.
ENABLE_DEV_LOGIN="false"
